<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".LeaseWithEaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android.fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeaseWithEase">
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LeaseWithEase">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AddContractActivity"
            android:label="Add Contract"
            android:theme="@style/Theme.LeaseWithEase" />
        <activity
            android:name=".EditContractActivity"
            android:label="Edit Contract"
            android:theme="@style/Theme.LeaseWithEase" />
        <activity
            android:name=".PlannedTripsActivity"
            android:label="Planned Trips"
            android:theme="@style/Theme.LeaseWithEase" />
        <activity
            android:name=".HelpActivity"
            android:label="Help"
            android:theme="@style/Theme.LeaseWithEase" />

        <!-- Widget configuration activity — shared by all three widget types -->
        <activity
            android:name=".widget.WidgetConfigurationActivity"
            android:exported="true"
            android:label="Select Vehicle"
            android:theme="@style/Theme.LeaseWithEase">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Widget 1: Compact Info -->
        <receiver
            android:name=".widget.CompactInfoWidgetReceiver"
            android:exported="true"
            android:label="@string/compact_info_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compact_info_widget_info" />
        </receiver>

        <!-- Widget 2: Quick Update -->
        <receiver
            android:name=".widget.QuickUpdateWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_update_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_update_widget_info" />
        </receiver>

        <!-- Widget 3: Visual -->
        <receiver
            android:name=".widget.VisualWidgetReceiver"
            android:exported="true"
            android:label="@string/visual_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/visual_widget_info" />
        </receiver>
    </application>

</manifest>